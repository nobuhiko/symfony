{
    "name": "umiushi-lab/symfony",
    "type": "library",
    "description": "The Symfony 2.7 components EC-CUBE 3.0.18 ships (2.7.52) with security fixes backported, for EC-CUBE 3.0.x shops that cannot move off the versions EC-CUBE 3.0.18 ships",
    "keywords": [
        "symfony",
        "security",
        "eccube"
    ],
    "homepage": "https://github.com/umiushi-lab/symfony",
    "license": "MIT",
    "authors": [
        {
            "name": "Fabien Potencier",
            "email": "fabien@symfony.com"
        },
        {
            "name": "Symfony Community",
            "homepage": "https://symfony.com/contributors"
        }
    ],
    "require": {
        "php": ">=5.3.9",
        "symfony/filesystem": "~2.3",
        "symfony/polyfill-ctype": "~1.8",
        "symfony/polyfill-mbstring": "~1.1",
        "symfony/event-dispatcher": "^2.6.7",
        "symfony/debug": "^2.6.2",
        "psr/log": "~1.0",
        "symfony/translation": "~2.4",
        "twig/twig": "~1.34|~2.4",
        "monolog/monolog": "~1.11"
    },
    "replace": {
        "symfony/config": "2.7.52",
        "symfony/dom-crawler": "2.7.52",
        "symfony/http-foundation": "2.7.52",
        "symfony/http-kernel": "2.7.52",
        "symfony/process": "2.7.52",
        "symfony/routing": "2.7.52",
        "symfony/serializer": "2.7.52",
        "symfony/validator": "2.7.52",
        "symfony/yaml": "2.7.52",
        "symfony/twig-bridge": "2.7.52",
        "symfony/monolog-bridge": "2.7.52"
    },
    "autoload": {
        "psr-4": {
            "Symfony\\Component\\Config\\": "src/Symfony/Component/Config/",
            "Symfony\\Component\\DomCrawler\\": "src/Symfony/Component/DomCrawler/",
            "Symfony\\Component\\HttpFoundation\\": "src/Symfony/Component/HttpFoundation/",
            "Symfony\\Component\\HttpKernel\\": "src/Symfony/Component/HttpKernel/",
            "Symfony\\Component\\Process\\": "src/Symfony/Component/Process/",
            "Symfony\\Component\\Routing\\": "src/Symfony/Component/Routing/",
            "Symfony\\Component\\Serializer\\": "src/Symfony/Component/Serializer/",
            "Symfony\\Component\\Validator\\": "src/Symfony/Component/Validator/",
            "Symfony\\Component\\Yaml\\": "src/Symfony/Component/Yaml/",
            "Symfony\\Bridge\\Twig\\": "src/Symfony/Bridge/Twig/",
            "Symfony\\Bridge\\Monolog\\": "src/Symfony/Bridge/Monolog/"
        },
        "classmap": [
            "src/Symfony/Component/HttpFoundation/Resources/stubs"
        ],
        "exclude-from-classmap": [
            "**/Tests/"
        ]
    },
    "support": {
        "issues": "https://github.com/umiushi-lab/symfony/issues"
    }
}
